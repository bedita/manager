<div class="backdrop" @click="closePanel()"></div>

<panel-view :custom-footer="true" :custom-header="true">
    <div class="panel-slot" slot-scope="props">
        <relations-add v-if="props && props.action === 'relations-add'" v-bind="(props && props.data) || {}" inline-template>
            {{ element('Panel/relations_add') }}
        </relations-add>
        <component v-else-if="props && props.action" v-bind:is="props.action" v-bind="(props && props.data) || {}"></component>
    </div>
</panel-view>
