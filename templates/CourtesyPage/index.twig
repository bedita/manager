{% do _view.assign('title', __('Maintenance in Progress')) %}
{% do _view.assign('bodyViewClass', 'view-login') %}
<div class="login">
    <div class="login-title">
        <div class="project-title">
            <div class="app-module-box">
                {{ Html.link((config('Project.name') ?: 'BEdita Content Manager'), '/')|raw }}
            </div>
        </div>
    </div>
    <div class="login-form">
        <h2>
            <app-icon icon="carbon:warning-hex-filled" color="orange"></app-icon>
            <span class="ml-05">{{ __('Maintenance in Progress') }}</span>
        </h2>
        <p>
            {{ message }}
        </p>
    </div>
    <footer>
        <div class="sidebar-footer">
            <div class="sidebar-bedita-logo white">{# css logo #}</div>
            {{ element('Menu/colophon') }}
        </div>
    </footer>
</div>
